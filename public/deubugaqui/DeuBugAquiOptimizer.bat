set "DB_VER=3.6.3"
set "DB_DIR=%LOCALAPPDATA%\DeuBugAqui\3.6.3"
set "DB_BAT=%~f0"
set "DB_LOG=%TEMP%\DeuBugAqui_Launcher.log"
chcp 65001 >nul

call :log "=== Deu Bug Aqui Optimizer v%DB_VER% iniciado ==="

powershell -NoProfile -Command "try { Unblock-File -Path '%DB_BAT%' -ErrorAction SilentlyContinue } catch {}" >nul 2>&1

if /i "%~1"=="DIAG" goto :diag

echo.
echo  ================================================================
echo   ██████╗ ███████╗    ████████╗███████╗ ██████╗
echo   ██╔══██╗╚══███╔╝    ╚══██╔══╝██╔════╝██╔════╝
echo   ██████╔╝  ███╔╝        ██║   █████╗  ██║
echo   ██╔══██╗ ███╔╝         ██║   ██╔══╝  ██║
echo   ██║  ██║███████╗       ██║   ███████╗╚██████╗
echo   ╚═╝  ╚═╝╚══════╝       ╚═╝   ╚══════╝ ╚═════╝
echo.
echo         D E U   B U G   A Q U I   O P T I M I Z E R
echo           Gaming Performance Suite  -  Developed by RZ
echo  ================================================================
echo   Produto licenciado - uso autorizado para clientes Deu Bug Aqui
echo  ================================================================
echo.

where powershell >nul 2>&1
if errorlevel 1 call :falha "O Windows PowerShell nao foi encontrado. Ele e padrao no Windows 10/11."

if not exist "%DB_DIR%" mkdir "%DB_DIR%"
set "_STAMP="
if exist "%DB_DIR%\versao.stamp" for /f "usebackq delims=" %%S in ("%DB_DIR%\versao.stamp") do set "_STAMP=%%S"
if "%_STAMP%"=="%DB_VER%" goto :pronto

echo  Preparando a aplicacao (primeira execucao desta versao)...
call :log "Extraindo aplicacao embutida..."
call :extrair
if errorlevel 1 call :falha "Falha ao preparar a aplicacao. Rode DeuBugAquiOptimizer.bat DIAG e envie o resultado."
if not exist "%DB_DIR%\DeuBugAquiOptimizer.ps1" call :falha "Extracao incompleta: arquivo principal ausente. Use o modo DIAG."
for %%A in ("%DB_DIR%\DeuBugAquiOptimizer.ps1") do if %%~zA LSS 100000 call :falha "Arquivo principal corrompido (tamanho anormal). Baixe o .bat novamente."
> "%DB_DIR%\versao.stamp" echo %DB_VER%
call :log "[OK] Aplicacao preparada em %DB_DIR%"

:pronto

rem ---- AUTO-CURA: roda em TODA execucao (corrige pasta extraida pela metade)
call :log "Verificando Win11Debloat (auto-cura)..."
call :w11dcheck

if exist "%~dp0logo.png" (
    if not exist "%DB_DIR%\assets" mkdir "%DB_DIR%\assets"
    copy /y "%~dp0logo.png" "%DB_DIR%\assets\logo.png" >nul 2>&1
)

if not exist "%DB_DIR%\licenca.aceita" (
    echo.
    echo  ================================================================
    echo   TERMOS DE USO
    echo  ================================================================
    echo   - Produto de uso autorizado para clientes Deu Bug Aqui;
    echo   - Toda alteracao no sistema e exibida antes de aplicar e pode
    echo     ser revertida - backups ficam em %%LOCALAPPDATA%%\DeuBugAqui;
    echo   - Nenhuma informacao deste computador e enviada a lugar nenhum;
    echo   - Nao redistribuir sem autorizacao da Deu Bug Aqui.
    echo   - O menu original do Win11Debloat (Raphire) e incluido sob a
    echo     licenca MIT, sem modificacoes.
    echo  ================================================================
    choice /c SN /m "Aceita os termos? [S]im [N]ao"
    if errorlevel 2 (
        echo  Termos recusados. O produto nao sera executado.
        pause
        exit /b
    )
    echo aceito em %date% > "%DB_DIR%\licenca.aceita"
)

call :log "Verificando elevacao..."
whoami /groups 2>nul | findstr /i /c:"S-1-16-12288" >nul
if not errorlevel 1 goto :elevado
fltmc >nul 2>&1
if not errorlevel 1 goto :elevado
call :log "Solicitando elevacao UAC..."
echo.
echo  Solicitando privilegios de administrador...
echo  Confirme a janela do Controle de Conta de Usuario (UAC).
powershell -NoProfile -Command "Start-Process -FilePath '%DB_BAT%' -Verb RunAs"
if errorlevel 1 call :falha "A elevacao foi cancelada ou falhou. Clique com o botao direito no arquivo e escolha Executar como administrador."
exit /b
:elevado
call :log "[OK] Elevado."

powershell -NoProfile -ExecutionPolicy Bypass -File "%DB_DIR%\DeuBugAquiOptimizer.ps1" %*
if errorlevel 1 call :falha "O produto encerrou com erro. Veja o log: %DB_LOG%"
call :log "Sessao encerrada normalmente."
echo.
echo  ----------------------------------------------------------------
echo  Obrigado por usar o Deu Bug Aqui Optimizer!
echo  Log da sessao: %DB_LOG%
echo  ----------------------------------------------------------------
echo.
pause
exit /b 0

rem ================================================================
rem  ROTINAS DE APOIO
rem ================================================================
:falha
echo.
echo  [ERRO] %~1
call :log "[ERRO] %~1"
echo  Log completo: %DB_LOG%
echo  Dica: rode DeuBugAquiOptimizer.bat DIAG para o diagnostico.
echo.
pause
exit /b 1

:log
>> "%DB_LOG%" echo [%time:~0,8%] %~1
exit /b

:w11dcheck
powershell -NoProfile -Command "$ErrorActionPreference='SilentlyContinue'; $d=[IO.Path]::Combine($env:DB_DIR,'Win11Debloat'); $ok=(Test-Path ([IO.Path]::Combine($d,'Win11Debloat.ps1'))) -and (Test-Path ([IO.Path]::Combine($d,'Scripts/CLI/Show-CliMenuOptions.ps1'))); if(-not $ok){$self=[IO.File]::ReadAllText($env:DB_BAT); $m=[regex]::Match($self,'::PAYLOAD_W11D_BEGIN::([A-Za-z0-9+/=]+)'); if($m.Success){[IO.File]::WriteAllBytes((Join-Path $env:DB_DIR 'w11d.zip'),[Convert]::FromBase64String($m.Groups[1].Value));if(Test-Path $d){Remove-Item $d -Recurse -Force -ErrorAction SilentlyContinue};Expand-Archive -Path (Join-Path $env:DB_DIR 'w11d.zip') -DestinationPath $d -Force -ErrorAction SilentlyContinue;Remove-Item (Join-Path $env:DB_DIR 'w11d.zip') -Force -ErrorAction SilentlyContinue}}"
exit /b

:extrair
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; $self=[IO.File]::ReadAllText($env:DB_BAT); $m=[regex]::Match($self,'::PAYLOAD_PS1_BEGIN::([A-Za-z0-9+/=]+)'); if(-not $m.Success){throw 'payload nao encontrado'}; [IO.File]::WriteAllText((Join-Path $env:DB_DIR 'DeuBugAquiOptimizer.ps1'),[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($m.Groups[1].Value)),(New-Object System.Text.UTF8Encoding($true))); $m2=[regex]::Match($self,'::PAYLOAD_LOGO_BEGIN::([A-Za-z0-9+/=]+)'); if($m2.Success){[IO.File]::WriteAllText((Join-Path $env:DB_DIR 'logo.txt'),[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($m2.Groups[1].Value)))}; $m3=[regex]::Match($self,'::PAYLOAD_W11D_BEGIN::([A-Za-z0-9+/=]+)'); if($m3.Success){[IO.File]::WriteAllBytes((Join-Path $env:DB_DIR 'w11d.zip'),[Convert]::FromBase64String($m3.Groups[1].Value));$w11dDir=[IO.Path]::Combine($env:DB_DIR,'Win11Debloat');$w11dOk=(Test-Path ([IO.Path]::Combine($w11dDir,'Win11Debloat.ps1'))) -and (Test-Path ([IO.Path]::Combine($w11dDir,'Scripts/CLI/Show-CliMenuOptions.ps1')));if((Test-Path $w11dDir) -and -not $w11dOk){Remove-Item $w11dDir -Recurse -Force -ErrorAction SilentlyContinue};if(-not (Test-Path $w11dDir)){Expand-Archive -Path (Join-Path $env:DB_DIR 'w11d.zip') -DestinationPath $w11dDir -Force};Remove-Item (Join-Path $env:DB_DIR 'w11d.zip') -Force -ErrorAction SilentlyContinue}"
exit /b

:diag
call :log "=== MODO DIAGNOSTICO ==="
call :log "PC: %COMPUTERNAME% | Usuario: %USERNAME% | BAT: %DB_BAT%"
echo ================================================================
echo  DEU BUG AQUI OPTIMIZER - DIAGNOSTICO DO LAUNCHER  v%DB_VER%
echo  Log: %DB_LOG%
echo ================================================================
echo.
echo [1/8] Computador / Usuario / Arquivo:
echo   PC: %COMPUTERNAME% | Usuario: %USERNAME%
echo   BAT: %DB_BAT%
echo.
echo [2/8] PowerShell presente?
where powershell >nul 2>&1 && (echo   [OK] presente) || (echo   [FALHA] ausente)
powershell -NoProfile -Command "Write-Output ('   versao: ' + $PSVersionTable.PSVersion.ToString())"
echo.
echo [3/8] Elevacao:
whoami /groups 2>nul | findstr /i /c:"S-1-16-12288" >nul && (echo   [OK] elevado) || (echo   [INFO] sem elevacao - rode como administrador para o teste completo)
echo.
echo [4/8] Payload embutido neste arquivo:
findstr /c:"::PAYLOAD_PS1_BEGIN::" "%DB_BAT%" >nul && (echo   [OK] payload presente) || (echo   [FALHA] payload ausente - arquivo corrompido; baixe novamente)
echo.
echo [5/8] Teste de extracao:
if not exist "%DB_DIR%" mkdir "%DB_DIR%"
call :extrair
if errorlevel 1 (echo   [FALHA] extracao retornou erro) else (echo   [OK] extracao concluida)
if exist "%DB_DIR%\DeuBugAquiOptimizer.ps1" (echo   [OK] DeuBugAquiOptimizer.ps1 gerado) else (echo   [FALHA] arquivo nao gerado)
call :w11dcheck
if exist "%DB_DIR%\Win11Debloat\Win11Debloat.ps1" (echo   [OK] Win11Debloat principal presente) else (echo   [FALHA] Win11Debloat principal ausente)
if exist "%DB_DIR%\Win11Debloat\Scripts\CLI\Show-CliMenuOptions.ps1" (echo   [OK] Win11Debloat Scripts completo) else (echo   [FALHA] Scripts do Win11Debloat ausentes)
echo.
echo [6/8] Tamanho do arquivo extraido:
for %%A in ("%DB_DIR%\DeuBugAquiOptimizer.ps1") do echo   %%~zA bytes
echo.
echo [7/8] Politica de execucao do PowerShell:
powershell -NoProfile -Command "Write-Output ('   ' + (Get-ExecutionPolicy))"
echo.
echo [8/8] Sintaxe do produto (parse sem executar):
powershell -NoProfile -Command "try { $t=$null; $e=$null; [void][System.Management.Automation.Language.Parser]::ParseFile('%DB_DIR%\DeuBugAquiOptimizer.ps1',[ref]$t,[ref]$e); if ($e.Count -gt 0) { '   [FALHA] erros de sintaxe:'; $e | ForEach-Object { '     linha ' + $_.Extent.StartLineNumber + ': ' + $_.Message } } else { '   [OK] arquivo valido' } } catch { '   [FALHA] ' + $_.Exception.Message }"
echo.
echo  Concluido. Envie o conteudo da janela acima e o arquivo abaixo
echo  para o suporte Deu Bug Aqui:
echo  %DB_LOG%
call :log "=== FIM DO DIAGNOSTICO ==="
echo.
pause
exit /b 0

