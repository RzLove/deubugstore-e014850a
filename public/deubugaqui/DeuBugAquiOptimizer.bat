@echo off
setlocal EnableExtensions
title Deu Bug Aqui Optimizer
rem ================================================================
rem  DEU BUG AQUI OPTIMIZER  v3.6.3
rem  Gaming Performance Suite | Developed by RZ
rem
rem  Produto comercial de arquivo unico (aplicacao completa embutida).
rem  Inclui o menu original do Win11Debloat (Raphire, licenca MIT).
rem  Primeira execucao: extrai para %%LOCALAPPDATA%%\DeuBugAqui e abre.
